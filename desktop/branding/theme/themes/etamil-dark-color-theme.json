    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#4ADE80",
    "gitDecoration.ignoredResourceForeground": "#4C6285"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7C90AB", "fontStyle": "italic" }
    },
    {
      "name": "Keyword — the Tamil words the language is made of",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#1E9BE9" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#4ADE80" }
    },
    {
      "name": "Number, and the percentages a tax rate is written as",
      "scope": ["constant.numeric", "constant.language", "keyword.other.unit"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#E8EEF7" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#3B82F6" }
    },
    {
      "name": "Operator and punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#C9D6E5" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#F87171" }
    }
  ]
}
