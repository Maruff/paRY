# Generated corpora, tokenizers and reports — all reproducible from the source repos.
/data/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Android build output; the Gradle wrapper jar is fetched by `gradle wrapper`.
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/gradle/wrapper/gradle-wrapper.jar

# VS Code extension build output and dependencies.
/vscode/node_modules/
/vscode/out/
/vscode/*.vsix

# Packaging output: the frozen server, the staged payload and the zip.
/build/
/desktop/branding/theme/*.vsix

# The deploy payload, built by tar from paRY/, data/ and web/.
/pary-src.tar
