<?xml version="1.0" encoding="utf-8"?>
<!-- A drum, drawn rather than photographed: பறை is the instrument an
     announcement was made on. Vector so there are no binary assets in the
     repository and no density buckets to keep in step. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The shell -->
    <path
        android:fillColor="#8C3B1A"
        android:pathData="M30,40 h48 a4,4 0 0 1 4,4 v20 a4,4 0 0 1 -4,4 h-48 a4,4 0 0 1 -4,-4 v-20 a4,4 0 0 1 4,-4 z" />
    <!-- The heads -->
    <path
        android:fillColor="#F6ECE6"
        android:pathData="M26,40 h56 v4 h-56 z M26,64 h56 v4 h-56 z" />
    <!-- The tensioning ropes -->
    <path
        android:strokeColor="#F6ECE6"
        android:strokeWidth="2"
        android:pathData="M36,44 L48,64 M48,44 L60,64 M60,44 L72,64" />
</vector>
